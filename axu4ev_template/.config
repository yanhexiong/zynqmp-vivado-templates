
#
# Board and shared PS DDR4
#
CONFIG_BOARD_AXU4EV=y
CONFIG_PL_RESERVED_MB=1024
CONFIG_PL_CLOCK_MHZ=100
# end of Board and shared PS DDR4

#
# PS peripherals (disabled means controller/pin mux disabled)
#
CONFIG_PS_UART0=y
CONFIG_PS_I2C0=y
CONFIG_PS_GEM3=y
CONFIG_PS_QSPI=y
CONFIG_PS_EMMC=y
CONFIG_PS_SD=y
CONFIG_PS_USB0=y
CONFIG_PS_USB3=y
CONFIG_PS_DP=y
CONFIG_PS_RTC=y
# end of PS peripherals (disabled means controller/pin mux disabled)

#
# PL block design
#
CONFIG_PL_GPIO=y
CONFIG_PL_BRAM=y
CONFIG_PL_DMA=y
CONFIG_PL_UART=y
# end of PL block design
