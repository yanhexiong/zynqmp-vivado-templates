
#
# Board and shared DDR4
#
CONFIG_BOARD_FZ5D=y
# CONFIG_BOARD_FZ5C is not set
CONFIG_SPEED_1=y
# CONFIG_SPEED_2 is not set
CONFIG_PL_RESERVED_MB=1024
CONFIG_PL_CLOCK_MHZ=100
# end of Board and shared DDR4

#
# PS peripherals (disabled means controller/pin mux disabled)
#
CONFIG_PS_UART0=y

#
# UART0/J13 console and GPIO board controls are always enabled
#
CONFIG_PS_UART1=y
CONFIG_PS_I2C1=y
CONFIG_PS_CAN1=y
CONFIG_PS_GEM3=y
CONFIG_PS_QSPI=y
CONFIG_PS_EMMC=y
CONFIG_PS_SD=y
# CONFIG_PS_USB0 is not set
# CONFIG_PS_DP is not set
CONFIG_PS_RTC=y
# end of PS peripherals (disabled means controller/pin mux disabled)

#
# PL block design
#
CONFIG_PL_GPIO=y
CONFIG_PL_BRAM=y
CONFIG_PL_DMA=y
# CONFIG_PL_RS232 is not set

#
# HDMI/MIPI/VCU are extension points; this template adds no video IP
#
# end of PL block design
